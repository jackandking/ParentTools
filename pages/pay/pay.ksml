<view class="container">
    <view class="pay-info">
        <text class="title">🔐 解锁完整报告</text>
        <text class="price">1.00</text>
        <text class="unit">元</text>
    </view>

    <view class="loading-area" wx:if="{{paying && !errorMsg}}">
        <view class="spinner"></view>
        <text class="loading-text">正在调起支付...</text>
    </view>

    <view class="error-area" wx:if="{{errorMsg}}">
        <text class="error-icon">❌</text>
        <text class="error-text">{{errorMsg}}</text>
        <button class="btn-back" bindtap="goBack">返回</button>
    </view>
</view>
